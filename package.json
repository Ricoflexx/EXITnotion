{
  "name": "exitnotion",
  "version": "0.1.0",
  "private": true,
  "description": "Eigen werkplek in de stijl van Notion voor de stagiairs van EXIT Toys",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:local": "bash scripts/local-db.sh"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@blocknote/server-util": "^0.57.0",
    "@blocknote/xl-multi-column": "^0.57.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
