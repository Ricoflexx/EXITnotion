# Kopieer naar .env.local en vul in.

# Database (lokaal: npm run db:local start een PostgreSQL op poort 5432)
DATABASE_URL=postgres://exitnotion:exitnotion@localhost:5432/exitnotion

# Auth.js: genereer met `openssl rand -base64 32`
AUTH_SECRET=
# Lokale URL; op Azure de echte URL, bijvoorbeeld https://werkplek.dutchtoysgroup.com
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (app-registratie, zie docs/azure-setup.md)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Beheerders: object-id van de Entra-groep "EXITnotion-Beheerders" (aanbevolen)
ADMIN_GROUP_ID=
# Of (alleen als er geen groep is): komma-gescheiden e-mailadressen
ADMIN_EMAILS=

# Alleen lokaal: inloggen als testgebruiker zonder Microsoft. Werkt nooit op Azure.
AUTH_DEV_LOGIN=true
